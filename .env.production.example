# Contoh .env untuk PRODUCTION. Salin menjadi .env di server, lalu isi nilai yang sesuai.
APP_NAME="SIM-Fleet RS"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false                # WAJIB false
APP_URL=https://fleet.contoh-rs.co.id
APP_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sim_fleet_rs
DB_USERNAME=fleet_app          # user khusus aplikasi, BUKAN root
DB_PASSWORD=
DB_DUMP_PATH=                  # folder berisi mysqldump, mis. /usr/bin (lihat docs/BACKUP.md)

SESSION_DRIVER=database
SESSION_LIFETIME=60            # menit tidak aktif sebelum logout otomatis
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true     # wajib jika memakai HTTPS
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
BCRYPT_ROUNDS=12

# Email (reset password & notifikasi)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@contoh-rs.co.id"
MAIL_FROM_NAME="${APP_NAME}"

# Backup: kata sandi untuk mengenkripsi arsip zip (opsional tapi disarankan)
BACKUP_ARCHIVE_PASSWORD=
